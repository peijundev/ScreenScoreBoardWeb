{
  "name": "@peijundev/screenscoreboard",
  "version": "1.6.2",
  "description": "实时计分板（React UI）：显示端 + 管理端，多项目，WebSocket 实时同步，可切换存储后端（JSON/SQLite/PostgreSQL/MySQL）",
  "license": "MIT",
  "author": {
    "name": "peijundev",
    "email": "screen-scoreboard@example.com"
  },
  "keywords": [
    "scoreboard",
    "计分板",
    "投票",
    "大屏",
    "realtime",
    "websocket"
  ],
  "main": "server/index.js",
  "bin": {
    "screenscoreboard": "./bin/screenscoreboard.js",
    "screenscoreboard-mcp": "./bin/screenscoreboard-mcp.js",
    "screenscoreboard-auth": "./bin/screenscoreboard-auth.js"
  },
  "files": [
    "server/",
    "public/",
    "bin/",
    "README.md"
  ],
  "scripts": {
    "start": "node server/index.js",
    "start:build": "npm run build:web && node server/index.js",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "electron": "electron electron/main.js",
    "dist": "npm run build:web && electron-builder --publish never",
    "dist:linux": "npm run build:web && electron-builder --linux --publish never",
    "dist:win": "npm run build:web && electron-builder --win --publish never",
    "dist:mac": "npm run build:web && electron-builder --mac --publish never",
    "prepublishOnly": "npm run build:web",
    "preelectron": "npm run build:web",
    "prestart": "npm run build:web",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "format": "prettier --write \"server/**/*.js\" \"scripts/**/*.mjs\" \"web/src/**/*.{ts,tsx}\"",
    "test:theme": "node --test scripts/theme-schema.test.mjs scripts/theme-script.test.mjs",
    "test:api": "node --test scripts/api-v1.test.mjs",
    "test:mcp": "node --test scripts/mcp.test.mjs",
    "test:mobile": "node --test scripts/mobile-ui.test.mjs",
    "test:auth": "node --test scripts/auth.test.mjs scripts/electron-mode.test.mjs",
    "sdk:build": "npm --prefix packages/sdk run build",
    "sdk:test": "npm --prefix packages/sdk test",
    "sdk:pack": "npm pack ./packages/sdk --dry-run",
    "auth:reset": "node bin/screenscoreboard-auth.js",
    "mcp:stdio": "node bin/screenscoreboard-mcp.js",
    "test:all": "node --test scripts/theme-schema.test.mjs scripts/theme-script.test.mjs scripts/api-v1.test.mjs scripts/mcp.test.mjs scripts/mobile-ui.test.mjs scripts/auth.test.mjs scripts/electron-mode.test.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1",
    "ws": "^8.18.0",
    "zustand": "^5.1.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@45.3.2": true,
    "electron-winstaller@5.4.0": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.screenscoreboard.app",
    "productName": "ScreenScoreBoard",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "executableName": "ScreenScoreBoard",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  }
}
