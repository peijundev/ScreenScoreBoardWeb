{
  "name": "ScreenScoreBoard (Node 24)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "containerEnv": {
    "TZ": "Asia/Shanghai"
  },
  "forwardPorts": [3000, 5173, 9222, 9331, 9332, 9333],
  "portsAttributes": {
    "3000": {
      "label": "后端（含构建后的前端）",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite 开发服务器",
      "onAutoForward": "silent"
    },
    "9222": {
      "label": "Electron 渲染进程调试",
      "onAutoForward": "silent"
    },
    "9331": {
      "label": "Electron 主进程调试",
      "onAutoForward": "silent"
    },
    "9332": {
      "label": "测试子进程调试（API）",
      "onAutoForward": "silent"
    },
    "9333": {
      "label": "测试子进程调试（MCP）",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    },
    "jetbrains": {
      "backend": "WebStorm"
    }
  },
  "remoteUser": "node"
}
