[Unit]
Description=ScreenScoreBoard 计分板服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scoreboard
Group=scoreboard
WorkingDirectory=/opt/screenscoreboard
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATA_DIR=/var/lib/screenscoreboard
EnvironmentFile=-/etc/screenscoreboard/env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/screenscoreboard
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
